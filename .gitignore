# Progression et contexte : locaux à chaque machine, jamais versionnés.
.dsoxlab.db
.dsoxlab-context.json

# Clé privée d'automatisation, posée par `dsoxlab instructor bootstrap`.
ssh/id_ed25519

# Répertoires de travail des labs `shell` : ce que l'apprenant y écrit lui
# appartient, et le catalogue les recrée à chaque `run`.
labs/**/challenge/work/

# Caches Python : pytest les recrée, et un .pyc versionné se périme en silence
# d'une version d'interpréteur à l'autre.
__pycache__/
*.pyc
.pytest_cache/

# Réglages Claude Code propres à ce poste : autorisations de commandes.
.claude/settings.local.json

# Le mot de passe qui déchiffre les solutions du formateur. Jamais commité :
# le commiter annulerait le chiffrement, puisqu'il voyage avec ce qu'il ouvre.
.vault-pass
